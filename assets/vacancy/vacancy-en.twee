ft:-4em;width:3em}tw-icon{color:#b39a63}em{color:#e2c68b}strong{color:#ead6ac}@media(max-width:640px){tw-story{padding:24px 24px 64px;font-size:16px;width:100%;border:none}h1{font-size:62px}h2{font-size:27px}.hero{gap:22px}.sigil{min-width:70px;height:118px;font-size:44px}.quote{font-size:19px}tw-sidebar{position:relative;left:0;display:flex;width:100%;gap:18px;padding:0;margin:0 0 10px}tw-icon{font-size:24px}}
